+#elif defined(__wasi__)
+
+/* WASI exposes clocks, but not process CPU accounting via getrusage.
+ * These diagnostic timers measure monotonic elapsed time on this target. */
+#include <time.h>
+
+static struct timespec wasi_timer_start;
+
+void
+startTimer(void)
+{
+    clock_gettime(CLOCK_MONOTONIC, &wasi_timer_start);
+}
+
+l_float32
+stopTimer(void)
+{
+struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (l_float32)(now.tv_sec - wasi_timer_start.tv_sec) +
+           (l_float32)(now.tv_nsec - wasi_timer_start.tv_nsec) / 1.0e9f;
+}
+
+L_TIMER
+startTimerNested(void)
+{
+struct timespec *start = LEPT_CALLOC(1, sizeof(*start));
+    if (start) clock_gettime(CLOCK_MONOTONIC, start);
+    return start;
+}
+
+l_float32
+stopTimerNested(L_TIMER timer)
+{
+struct timespec now;
+struct timespec *start = timer;
+l_float32 elapsed;
+    if (!start) return 0.0f;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    elapsed = (l_float32)(now.tv_sec - start->tv_sec) +
+              (l_float32)(now.tv_nsec - start->tv_nsec) / 1.0e9f;
+    LEPT_FREE(start);
+    return elapsed;
+}
+
+void
+l_getCurrentTime(l_int32 *sec, l_int32 *usec)
+{
+struct timespec now;
+    clock_gettime(CLOCK_REALTIME, &now);
+    if (sec) *sec = (l_int32)now.tv_sec;
+    if (usec) *usec = (l_int32)(now.tv_nsec / 1000);
+}
+
